# ============================================================================
# Environment variables to add in Vercel -> Project -> Settings -> Environment Variables
# (NEVER commit real values. This file is only a checklist.)
# ============================================================================

APP_NAME=NightLifeBD
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show   (run locally, paste the "base64:..." value)
APP_KEY=
# Your Vercel production URL or custom domain, no trailing slash
APP_URL=https://your-project.vercel.app
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- TiDB Cloud (MySQL compatible) -----------------------------------------
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=nightlifebd
# TiDB Cloud usernames carry a prefix, e.g. 3pTAoNNegb47Uc8.root
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true

# ---- Stateless runtime ------------------------------------------------------
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
NIGHTLIFE_USE_QUEUE=false
NIGHTLIFE_DEMO_ENABLED=false

# ---- Incident photo storage (S3 compatible: Cloudflare R2 / AWS S3 / B2) ----
# Without this, uploaded photos are lost between requests.
REPORT_PHOTOS_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# R2: https://<accountid>.r2.cloudflarestorage.com   (leave empty for AWS S3)
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Cron endpoint (must match the CRON_SECRET GitHub secret) --------------
# openssl rand -hex 32
CRON_SECRET=

# ---- Mail (MAIL_MAILER=log would silently drop emails on Vercel) ------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---- Optional integrations (app works without them) -------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ORS_API_KEY=
TELEGRAM_BOT_TOKEN=
